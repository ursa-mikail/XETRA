#!/usr/bin/env bash
# Start the XETRA demo stack: dashboard at http://localhost:8420 plus a scheduled
# cycle every 5 minutes (the first one starts immediately).
set -euo pipefail
cd "$(dirname "$0")"
[ -f config/config.yaml ] || cp config/config.example.yaml config/config.yaml
(cd docker && docker compose up --build -d)
echo ""
echo "XETRA is up."
echo "Dashboard: http://localhost:8420"
echo "(the first cycle takes a few seconds to land — the dashboard picks it up automatically)"
